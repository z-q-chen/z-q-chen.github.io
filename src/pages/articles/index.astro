---
import Layout from '../../layouts/Layout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import {getCollection} from 'astro:content';
const articles=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const kinds=['全部',...new Set(articles.map(a=>a.data.kind))];
---
<Layout title="文章 · 陈正佺数字实验室" active="articles"><header class="page-intro"><p class="eyebrow">ARTICLES / THINKING IN WORDS</p><h1>一边探索，<span class="serif accent">一边写下。</span></h1><p>这里发布思考、教程、开发记录与随笔。留下问题，也留下走向答案的过程。</p></header><div class="page-content">{articles.length ? <>{kinds.length>2&&<div class="filter-bar" aria-label="文章类型筛选">{kinds.map((k,i)=><button data-article-filter={k} aria-pressed={i===0?'true':'false'}>{k}</button>)}</div>}<div class="article-list">{articles.map(article=><div data-article-kind={article.data.kind}><ArticleRow article={article}/></div>)}</div></> : <div class="collection-empty"><span class="empty-symbol" aria-hidden="true">✎</span><h2>暂无已发布文章</h2><p>思考与教程会陆续发布在这里。<br/>你也可以通过 RSS 订阅之后的更新。</p><a class="text-link" href="/feed.xml">订阅 RSS ↗</a></div>}</div></Layout>
<script>document.querySelectorAll<HTMLButtonElement>('[data-article-filter]').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('[data-article-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===btn)));document.querySelectorAll<HTMLElement>('[data-article-kind]').forEach(row=>{row.hidden=btn.dataset.articleFilter!=='全部'&&row.dataset.articleKind!==btn.dataset.articleFilter;});}));</script>
