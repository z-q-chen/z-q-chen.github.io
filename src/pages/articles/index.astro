---
import Layout from '../../layouts/Layout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import {published} from '../../lib/content';
const {articles,series}=await published();const kinds=[...new Set(articles.map(a=>a.data.kind))];const years=[...new Set(articles.map(a=>a.data.date.getUTCFullYear()))];const tags=[...new Set(articles.flatMap(a=>a.data.tags))];
---
<Layout title="文章 · ECHO" active="articles"><header class="page-heading"><p class="eyebrow">WORDS, ONE BY ONE</p><h1>文章<span class="title-dot">.</span></h1><p>学习笔记、思考和教程。一篇一篇，留住理解的过程。</p></header><div class="archive-layout"><section><div class="filter-bar" aria-label="文章类型筛选"><button data-kind="全部" aria-pressed="true">全部 <span>{articles.length}</span></button>{kinds.map(kind=><button data-kind={kind} aria-pressed="false">{kind}</button>)}</div><div class="selected-tag" hidden><span data-tag-label></span><a href="/articles/">清除 ×</a></div>{years.map(year=><section data-year class="year-section"><h2 class="archive-year">{year}</h2>{articles.filter(a=>a.data.date.getUTCFullYear()===year).map(article=><div data-entry data-kind={article.data.kind} data-tags={JSON.stringify(article.data.tags)}><ArticleRow article={article}/></div>)}</section>)}<p data-empty class="empty-copy" hidden>这个分类还没有文章，试试其他主题。</p></section><aside class="archive-aside"><h2>按系列阅读</h2>{series.map(group=><a class="series-mini" href={`/series/${group.id}/`}><span class:list={['tiny-dot',group.data.color]}></span>{group.data.label}<span>↗</span></a>)}<h2>顺着关键词</h2><div class="topic-links">{tags.map(tag=><a href={`/articles/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div></aside></div></Layout>
<script>
const tag=new URLSearchParams(location.search).get('tag');let kind='全部';const rows=[...document.querySelectorAll<HTMLElement>('[data-entry]')];if(tag){document.querySelector<HTMLElement>('.selected-tag')!.hidden=false;document.querySelector('[data-tag-label]')!.textContent=`主题 · ${tag}`;}
function apply(){let count=0;rows.forEach(row=>{const show=(kind==='全部'||row.dataset.kind===kind)&&(!tag||JSON.parse(row.dataset.tags||'[]').includes(tag));row.hidden=!show;if(show)count++;});document.querySelectorAll<HTMLElement>('[data-year]').forEach(section=>{section.hidden=![...section.querySelectorAll<HTMLElement>('[data-entry]')].some(row=>!row.hidden);});document.querySelector<HTMLElement>('[data-empty]')!.hidden=count>0;}
document.querySelectorAll<HTMLButtonElement>('.filter-bar [data-kind]').forEach(button=>button.addEventListener('click',()=>{kind=button.dataset.kind||'全部';document.querySelectorAll('.filter-bar [data-kind]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));apply();}));apply();
</script>
