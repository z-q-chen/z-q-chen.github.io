---
import Layout from '../../layouts/Layout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import {getCollection} from 'astro:content';
const articles=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const kinds=['全部',...new Set(articles.map(a=>a.data.kind))];
const tags=[...new Set(articles.flatMap(a=>a.data.tags))];
const years=[...new Set(articles.map(a=>a.data.date.getUTCFullYear()))];
---
<Layout title="文章 · ECHO" active="articles">
<header class="page-heading"><p class="eyebrow">THE JOURNAL</p><h1>文章<span class="accent">.</span></h1><p>思考、记录，以及一些可以复用的方法。</p></header>
<div class="page-content archive-grid"><section aria-label="文章归档">
<div class="filter-bar" aria-label="文章类型筛选">{kinds.map((kind,i)=><button data-article-filter={kind} aria-pressed={String(i===0)}>{kind}</button>)}</div>
<p class="search-status" data-tag-status hidden></p>
{years.map(year=><section class="archive-year-section" data-archive-year><h2 class="archive-year">{year}</h2>{articles.filter(a=>a.data.date.getUTCFullYear()===year).map(article=><div data-article-kind={article.data.kind} data-article-tags={JSON.stringify(article.data.tags)}><ArticleRow article={article}/></div>)}</section>)}
<p class="search-empty" data-filter-empty hidden>还没有符合条件的文章。</p>
{!articles.length&&<div class="empty-state"><h2>第一篇，慢慢来。</h2><p>写好之后，再放到这里。</p></div>}
</section><aside class="archive-notes"><h2>随时翻开</h2><p>不用按顺序阅读。跟着一个问题，或一个感兴趣的词，走进去。</p><div class="topic-links">{tags.map(tag=><a href={`/articles/?tag=${encodeURIComponent(tag)}`}># {tag}</a>)}</div><a class="text-link" href="/feed.xml">通过 RSS 订阅 <span>↗</span></a></aside></div>
</Layout>
<script>
const tag=new URLSearchParams(location.search).get('tag'); let kind='全部';
const rows=[...document.querySelectorAll<HTMLElement>('[data-article-kind]')];
const tagStatus=document.querySelector<HTMLElement>('[data-tag-status]');
if(tag&&tagStatus){tagStatus.hidden=false;tagStatus.textContent=`主题：${tag}`;}
function filter(){let count=0;rows.forEach(row=>{const match=(kind==='全部'||row.dataset.articleKind===kind)&&(!tag||JSON.parse(row.dataset.articleTags||'[]').includes(tag));row.hidden=!match;if(match)count++;});document.querySelectorAll<HTMLElement>('[data-archive-year]').forEach(section=>{section.hidden=![...section.querySelectorAll<HTMLElement>('[data-article-kind]')].some(row=>!row.hidden);});const empty=document.querySelector<HTMLElement>('[data-filter-empty]');if(empty)empty.hidden=count>0||rows.length===0;}
document.querySelectorAll<HTMLButtonElement>('[data-article-filter]').forEach(button=>button.addEventListener('click',()=>{kind=button.dataset.articleFilter||'全部';document.querySelectorAll('[data-article-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));filter();}));filter();
</script>
