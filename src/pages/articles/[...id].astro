---
import Layout from '../../layouts/Layout.astro';
import ViewCount from '../../components/ViewCount.astro';
import 'katex/dist/katex.min.css';
import {published,sequence,connections} from '../../lib/content';
import {render} from 'astro:content';
import {dateLabel,readingTime} from '../../lib/editorial';
export async function getStaticPaths(){const {articles}=await published();return articles.map(article=>({params:{id:article.id},props:{article}}));}
const {article}=Astro.props;const {articles,series}=await published();const {Content,headings}=await render(article);const toc=headings.filter(h=>h.depth===2);const group=series.find(s=>s.id===article.data.series);const siblings=group?articles.filter(a=>a.data.series===group.id).sort(sequence):[];const index=siblings.findIndex(a=>a.id===article.id);const previous=siblings[index-1],next=siblings[index+1];const {related,backlinks}=connections(article,articles);
---
<Layout title={`${article.data.title} · ECHO`} description={article.data.description} active="articles" article><progress class="reading-progress" data-reading-progress max="100" value="0" aria-label="阅读进度"></progress><article class:list={['article-top',{'plan-article':article.data.kind==='学习计划'}]}><a class="back-link" href="/articles/">← 所有文章</a><header class="article-header">{group&&<a class:list={['series-pill',group.data.color]} href={`/series/${group.id}/`}>{group.data.label} <span>· 系列第 {index+1} 篇 ↗</span></a>}<div class="post-meta"><span class="kind">{article.data.kind}</span><time datetime={article.data.date.toISOString()}>{dateLabel(article.data.date)}</time><span>约 {readingTime(article.body)} 分钟</span><ViewCount id={article.id}/>{article.data.updated&&<span>更新于 {dateLabel(article.data.updated)}</span>}</div><h1>{article.data.title}</h1><p class="article-description">{article.data.description}</p><div class="tags">{article.data.tags.map((tag:string)=><a href={`/articles/?tag=${encodeURIComponent(tag)}`}># {tag}</a>)}</div></header><div class="reading-shell"><div>{(toc.length>0||group)&&<details class="mobile-toc"><summary>本页目录{group?'与系列':''}</summary><nav aria-label="本页目录">{toc.map(h=><a href={`#${h.slug}`}>{h.text}</a>)}{group&&<a href={`/series/${group.id}/`}>↗ {group.data.label} · 完整系列</a>}</nav></details>}<div class="prose"><Content/></div><footer class="article-end">{(previous||next)&&<nav class="series-pagination" aria-label="系列前后篇">{previous&&<a href={`/articles/${previous.id}/`}><small>← 上一篇</small>{previous.data.title}</a>}{next&&<a href={`/articles/${next.id}/`}><small>下一篇 →</small>{next.data.title}</a>}</nav>}{related.length>0&&<section class="connection-section"><h2>接着读</h2><div class="connection-list">{related.map(a=><a href={`/articles/${a.id}/`}>{a.data.title}<span>↗</span></a>)}</div></section>}{backlinks.length>0&&<section class="connection-section"><h2>提到这篇文章</h2><div class="connection-list">{backlinks.map(a=><a href={`/articles/${a.id}/`}>{a.data.title}<span>↗</span></a>)}</div></section>}<p class="article-footnote">写于 {dateLabel(article.data.date)} · ECHO</p><a class="quiet-link" href="/articles/">所有文章 →</a></footer></div><aside class="article-sidebar"><div class="sticky-sidebar">{toc.length>0&&<nav class="article-toc" aria-label="文章目录"><p>目录</p>{toc.map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav>}{group&&<div class="series-side"><a href={`/series/${group.id}/`}>{group.data.label} · 完整系列 ↗</a><ol>{siblings.map(a=><li aria-current={a.id===article.id?'page':undefined}>{a.id===article.id?<span>{a.data.title}</span>:<a href={`/articles/${a.id}/`}>{a.data.title}</a>}</li>)}</ol></div>}</div></aside></div></article></Layout>
<script>
const progress=document.querySelector<HTMLProgressElement>('[data-reading-progress]')!;const prose=document.querySelector<HTMLElement>('.prose')!;const links=[...document.querySelectorAll<HTMLAnchorElement>('.article-toc a')];const headings=links.map(a=>document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((h):h is HTMLElement=>!!h);
function update(){const start=prose.getBoundingClientRect().top+scrollY;const total=prose.offsetHeight-innerHeight/2;progress.value=Math.min(100,Math.max(0,(scrollY-start+innerHeight/3)/Math.max(total,1)*100));const active=headings.filter(h=>h.getBoundingClientRect().top<=innerHeight*.27).at(-1);links.forEach(a=>{if(active&&decodeURIComponent(a.hash.slice(1))===active.id)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});}addEventListener('scroll',update,{passive:true});addEventListener('resize',update);update();
</script>
