---
import Layout from '../layouts/Layout.astro';
import {bookmarks,shop} from '../data/links';
const groups=[...new Set(bookmarks.map(b=>b.group))];
---
<Layout title="书签 · ECHO" active="links"><header class="page-heading"><h1>书签<span class="title-dot">.</span></h1></header><div class="page-section links-list">{groups.map(group=><section class="bookmark-section"><h2 class="section-title">{group}</h2><div>{bookmarks.filter(b=>b.group===group).map(bookmark=><a class="bookmark-line" href={bookmark.url} target="_blank" rel="noopener noreferrer"><h3>{bookmark.title}</h3>{bookmark.description&&<p>{bookmark.description}</p>}<span aria-hidden="true">↗</span></a>)}</div></section>)}<section class="bookmark-section"><h2 class="section-title">小店</h2><a class="bookmark-line shop-line" href={shop.url} target="_blank" rel="noopener noreferrer sponsored nofollow"><h3>{shop.title}</h3><span aria-hidden="true">↗</span></a></section></div></Layout>
