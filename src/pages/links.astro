---
import Layout from '../layouts/Layout.astro';
import {bookmarks,shop} from '../data/links';
const groups=[...new Set(bookmarks.map(b=>b.group))];
---
<Layout title="书签 · ECHO" active="links"><header class="page-heading"><p class="eyebrow">GOOD PLACES TO GO</p><h1>书签<span class="title-dot">.</span></h1><p>一些学习入口，还有我的小店。把值得再去的地方放在一起。</p></header><div class="page-section">{groups.map(group=><section class="bookmark-section"><h2 class="section-title">{group}</h2><div class="bookmark-grid">{bookmarks.filter(b=>b.group===group).map(bookmark=><a class:list={['bookmark-card',bookmark.color]} href={bookmark.url} target="_blank" rel="noopener noreferrer"><h3>{bookmark.title}<span>↗</span></h3><p>{bookmark.description}</p><small>{new URL(bookmark.url).hostname}</small></a>)}</div></section>)}<section class="bookmark-section"><h2 class="section-title">我的小店 <span class="tiny-dot peach"></span></h2><a class="shop-card peach" href={shop.url} target="_blank" rel="noopener noreferrer sponsored nofollow"><span class="shop-symbol" aria-hidden="true">↗</span><div><span class="small-label">EXTERNAL SERVICE</span><h3>{shop.title}</h3><p>{shop.description}</p></div><span>去看看 ↗</span></a></section></div></Layout>
