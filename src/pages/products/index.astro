---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import LittleSpark from '../../components/LittleSpark.astro';
import {published} from '../../lib/content';
const {products}=await published();
---
<Layout title="产品 · ECHO" active="products"><header class="page-heading"><h1>产品<span class="title-dot">.</span></h1></header><div class="page-section">{products.length?<div class="product-grid">{products.map(product=><ProductCard product={product}/>)}</div>:<p class="empty-copy">暂无产品。</p>}</div></Layout>
