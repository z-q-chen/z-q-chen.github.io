---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="微小的生命 · 游乐场" active="lab"><a class="back-link" href="/lab/">← 返回游乐场</a><header class="lab-description"><div><p class="eyebrow">EXPERIMENT 002 / CELLULAR AUTOMATA</p><h1>微小的生命</h1><p>点击网格种下生命，或者从一个经典图案开始。每一步，简单规则都会写下新的局面。</p></div><span class="pill">交互实验</span></header>
<div class="experiment-surface"><div class="toolbar"><button id="life-play">开始演化 ▷</button><button id="life-step">单步</button><button id="life-clear">清空</button><button id="life-random">随机种子</button><label>图案 <select id="life-pattern"><option value="glider">滑翔机</option><option value="pulsar">脉冲星</option><option value="blinker">闪烁器</option></select></label><label>速度 <input id="life-speed" type="range" min="1" max="15" value="5"/></label><span class="stat" id="life-stat" aria-live="polite">第 0 代</span></div>
<div class="life-grid" id="life-grid" role="grid" aria-label="32 列 20 行的生命网格，方向键移动，空格切换细胞" data-cols="32" data-rows="20"></div><p class="life-summary" id="life-summary">点击切换细胞 · 方向键移动 · 空格种下生命</p></div>
<section class="experiment-info"><div><h2>三个生长规则</h2><ul><li>活细胞有 2 或 3 个活邻居，就会存活。</li><li>其他活细胞会因孤独或拥挤而消失。</li><li>空细胞恰好有 3 个活邻居，就会诞生。</li></ul></div><div><h2>试试看</h2><p>“闪烁器”会在两个状态之间交替；“滑翔机”会缓慢移动。网格边缘连接到另一侧，形成一个环面世界。修改图案会暂停演化并从第 0 代重新开始。</p><a class="text-link" href="/notes/rules-and-emergence/">阅读实验说明 →</a></div></section></Layout>
<script>
import {nextGeneration} from '../../scripts/life';
const grid=document.querySelector<HTMLElement>('#life-grid')!;const cols=32,rows=20,total=cols*rows;let cells=new Uint8Array(total),generation=0,running=false,timer:ReturnType<typeof setTimeout>|undefined;const play=document.querySelector<HTMLButtonElement>('#life-play')!;const speed=document.querySelector<HTMLInputElement>('#life-speed')!;const stat=document.querySelector<HTMLElement>('#life-stat')!;const summary=document.querySelector<HTMLElement>('#life-summary')!;
const buttons=Array.from({length:total},(_,i)=>{const b=document.createElement('button');b.className='life-cell';b.type='button';b.setAttribute('role','gridcell');b.tabIndex=i===0?0:-1;b.addEventListener('click',()=>{stop();cells[i]=cells[i]?0:1;render();});b.addEventListener('keydown',e=>{const directions:Record<string,number>={ArrowLeft:-1,ArrowRight:1,ArrowUp:-cols,ArrowDown:cols};if(e.key in directions){e.preventDefault();const index=(i+directions[e.key]+total)%total;buttons.forEach((x,j)=>x.tabIndex=j===index?0:-1);buttons[index].focus();}});grid.append(b);return b;});
function render(){let alive=0;buttons.forEach((b,i)=>{b.classList.toggle('alive',!!cells[i]);b.setAttribute('aria-label',`第 ${Math.floor(i/cols)+1} 行，第 ${i%cols+1} 列，${cells[i]?'存活':'空白'}`);b.setAttribute('aria-selected',String(!!cells[i]));alive+=cells[i];});stat.textContent=`第 ${generation} 代 / ${alive} 个细胞`;}
function stop(){running=false;clearTimeout(timer);play.textContent='开始演化 ▷';}
function step(){const next=nextGeneration(cells,cols,rows);const stable=next.every((v,i)=>v===cells[i]);cells=next;generation++;render();if(stable){stop();summary.textContent='世界已经稳定。添加一些细胞，再试一次。';}}
function tick(){if(!running)return;step();if(running)timer=setTimeout(tick,1000/Number(speed.value));}
function seed(kind:string){stop();cells.fill(0);generation=0;const patterns:Record<string,number[][]>={glider:[[1,0],[2,1],[0,2],[1,2],[2,2]],blinker:[[0,0],[1,0],[2,0]],pulsar:[]};if(kind==='pulsar'){for(const a of [2,3,4,8,9,10])for(const b of [0,5,7,12])patterns.pulsar.push([a,b],[b,a]);}for(const [x,y]of patterns[kind]||patterns.glider)cells[(y+3)*cols+x+9]=1;summary.textContent='点击切换细胞 · 方向键移动 · 空格种下生命';render();}
play.addEventListener('click',()=>{if(running)stop();else{running=true;play.textContent='暂停演化 Ⅱ';tick();}});document.querySelector('#life-step')!.addEventListener('click',()=>{stop();step();});document.querySelector('#life-clear')!.addEventListener('click',()=>{stop();cells.fill(0);generation=0;render();summary.textContent='网格已经清空，点击任意格子种下生命。';});document.querySelector('#life-random')!.addEventListener('click',()=>{stop();cells=cells.map(()=>Math.random()<.23?1:0);generation=0;render();summary.textContent='一片新的初始世界。点击开始，观察演化。';});document.querySelector<HTMLSelectElement>('#life-pattern')!.addEventListener('change',e=>seed((e.target as HTMLSelectElement).value));document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});seed('glider');
</script>
