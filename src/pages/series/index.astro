---
import Layout from '../../layouts/Layout.astro';
import SeriesCard from '../../components/SeriesCard.astro';
import {published} from '../../lib/content';
const {articles,series}=await published();
---
<Layout title="系列 · ECHO" active="series"><header class="page-heading"><h1>系列<span class="title-dot">.</span></h1></header><div class="series-grid page-section">{series.map(group=><SeriesCard group={group} articles={articles}/>)}</div></Layout>
