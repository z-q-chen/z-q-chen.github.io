---
import Layout from '../../layouts/Layout.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import {published,sequence} from '../../lib/content';
export async function getStaticPaths(){const {series}=await published();return series.map(group=>({params:{id:group.id},props:{group}}));}
const {group}=Astro.props;const {articles}=await published();const entries=articles.filter(a=>a.data.series===group.id).sort(sequence);
---
<Layout title={`${group.data.title} · ECHO`} description={group.data.description} active="series"><div class="breadcrumb"><a href="/series/">系列</a><span>/</span><span>{group.data.label}</span></div><header class="series-title"><h1>{group.data.title}</h1><span class="kind">{group.data.status}</span></header><section class="series-contents">{entries.map((article,i)=><div class="series-entry"><span class="entry-order">{article.data.kind==='系列总览'?'OV':String(entries.slice(0,i+1).filter(a=>a.data.kind!=='系列总览').length).padStart(2,'0')}</span><ArticleRow article={article}/></div>)}</section></Layout>
