---
import Layout from '../layouts/Layout.astro';
import {published} from '../lib/content';
const {articles,series,products}=await published();const entries=[...articles.map(a=>({title:a.data.title,description:a.data.description,tags:a.data.tags,type:'文章',url:`/articles/${a.id}/`,external:false})),...series.map(s=>({title:s.data.title,description:s.data.description,tags:[s.data.label],type:'系列',url:`/series/${s.id}/`,external:false})),...products.map(p=>({title:p.data.title,description:p.data.description,tags:p.data.tags,type:'产品',url:p.data.url,external:true}))];
---
<Layout title="搜索 · ECHO" noindex><header class="page-heading"><p class="eyebrow">FIND A LITTLE SOMETHING</p><h1>找点什么<span class="title-dot">.</span></h1><p>在文章、系列和产品中，搜索标题、简介与标签。</p></header><div class="page-section search-section"><form class="search-form" role="search" method="get" action="/search/"><input type="search" name="q" aria-label="搜索内容" placeholder="比如：CS229、机器学习…" autocomplete="off"/><button type="submit" aria-label="搜索">↗</button></form><p class="search-status" aria-live="polite" data-search-status></p>{entries.map(entry=><a class="search-result" href={entry.url} target={entry.external?'_blank':undefined} rel={entry.external?'noopener noreferrer':undefined} data-search-text={[entry.title,entry.description,...entry.tags].join(' ').toLocaleLowerCase()}><span class="kind">{entry.type}</span><h2>{entry.title}<span>↗</span></h2><p>{entry.description}</p></a>)}<p class="empty-copy" data-search-empty hidden>还没有找到。换个关键词试试？</p></div></Layout>
<script>
const input=document.querySelector<HTMLInputElement>('input[name=q]')!;const results=[...document.querySelectorAll<HTMLElement>('[data-search-text]')];function search(){const query=input.value.trim();const terms=query.toLocaleLowerCase().split(/\s+/).filter(Boolean);let count=0;results.forEach(result=>{result.hidden=!terms.every(term=>result.dataset.searchText?.includes(term));if(!result.hidden)count++;});document.querySelector('[data-search-status]')!.textContent=query?`找到 ${count} 条结果`:`全部内容 · ${count} 条`;document.querySelector<HTMLElement>('[data-search-empty]')!.hidden=count>0;const url=new URL(location.href);if(query)url.searchParams.set('q',query);else url.searchParams.delete('q');history.replaceState(null,'',url);}input.value=new URLSearchParams(location.search).get('q')||'';input.addEventListener('input',search);search();
</script>
