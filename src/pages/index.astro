---
import Layout from '../layouts/Layout.astro';
import EditorialArt from '../components/EditorialArt.astro';
import ArticleRow from '../components/ArticleRow.astro';
import WorkCard from '../components/WorkCard.astro';
import {getCollection} from 'astro:content';
import {channels} from '../data/channels';
const articles=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const works=(await getCollection('works',({data})=>!data.draft)).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||b.data.date.valueOf()-a.data.date.valueOf());
const tags=[...new Set(articles.flatMap(a=>a.data.tags))].slice(0,6);
---
<Layout active="home">
<section class="journal-hero"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span>NOTES & SMALL THINGS</p><h1>保持好奇，<br/>慢慢<span class="hero-accent">成形。</span></h1><p class="hero-lede">写下思考与教程，<br class="mobile-break"/>收好做出来的东西。</p><a class="text-link hero-link" href={articles.length?`/articles/${articles[0].id}/`:'/articles/'}>开始阅读 <span aria-hidden="true">↗</span></a></div><div class="hero-art"><EditorialArt/><span class="art-caption" lang="en">a work in progress, always.</span></div></section>
<div class="home-grid"><div class="home-main"><section class="journal-section"><div class="section-heading"><div><p class="eyebrow">THE JOURNAL</p><h2>最近写下的<span class="section-count">{String(articles.length).padStart(2,'0')}</span></h2></div><a class="text-link" href="/articles/">全部文章 ↗</a></div>{articles.length?<div class="article-list">{articles.slice(0,4).map(article=><ArticleRow article={article}/>)}</div>:<div class="empty-state"><p>第一篇，慢慢写。</p></div>}</section>
<section class="journal-section"><div class="section-heading"><div><p class="eyebrow">MADE WITH CURIOSITY</p><h2>做出来的东西<span class="section-count">{String(works.length).padStart(2,'0')}</span></h2></div><a class="text-link" href="/works/">所有作品 ↗</a></div>{works.length?<div class="work-grid home-work-grid">{works.slice(0,2).map(work=><WorkCard work={work}/>)}</div>:<a class="work-placeholder" href="/works/"><svg viewBox="0 0 70 70" aria-hidden="true"><path d="M12 22L29 13L58 24L41 35ZM12 22L41 35L41 59L13 46ZM41 35L58 24L57 48L41 59Z"/><path d="M22 18L49 29L49 39"/></svg><div><h3>给下一件作品，留一块地方。</h3><p>成品发布后，会收在这里。</p></div><span aria-hidden="true">↗</span></a>}</section></div>
<aside class="home-aside"><section class="author-note"><div class="author-top"><span class="author-seal" aria-hidden="true">e.</span><div><p class="eyebrow">THE PERSON BEHIND</p><h2>ECHO</h2></div></div><p>写一点想法，做一些小东西。<br/>这里是一份持续生长的个人记录。</p><a class="text-link" href="/about/">认识一下 ↗</a><svg class="note-sprig" viewBox="0 0 70 85" aria-hidden="true"><path d="M21 80Q40 49 45 10M34 58Q12 57 14 38Q29 36 34 58M42 36Q64 34 61 17Q45 16 42 36"/></svg></section>
<section class="aside-section"><p class="eyebrow">EXPLORE</p><div class="aside-channels">{channels.map((c,i)=><a href={`/collections/${c.id}/`}><span class="channel-number">0{i+1}</span>{c.label}<span aria-hidden="true">↗</span></a>)}</div></section>
{tags.length>0&&<section class="aside-section"><p class="eyebrow">TOPICS</p><div class="topic-links">{tags.map(tag=><a href={`/articles/?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}</div></section>}
<a class="rss-note" href="/feed.xml"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="19" r="1.5"/><path d="M4 11C9 11 13 15 13 20M4 4C13 4 20 11 20 20"/></svg><span>用 RSS，慢慢读。<small>更新时再相见。</small></span></a></aside></div>
</Layout>
<script>import {legacyEntries} from '../data/channels';const old=legacyEntries.find(entry=>entry.id===location.hash.slice(1));if(old)location.replace(old.href);</script>
