---
import Layout from '../layouts/Layout.astro';
import OrbitCanvas from '../components/OrbitCanvas.astro';
import Visual from '../components/Visual.astro';
import {experiments,projects} from '../data/lab';
import {getCollection} from 'astro:content';
const notes=(await getCollection('notes',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Layout>
<section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> CHEN ZHENGQUAN / PERSONAL DIGITAL LAB</p><h1>想法在这里<br/>慢慢<span class="serif accent">生长。</span><span class="asterisk">✳</span></h1><p class="hero-description">你好，我是陈正佺。<br/>这里存放关于模型、代码与交互的探索，<br class="desktop-break"/>也给那些尚未成形的想法留一个位置。</p><div class="hero-actions"><a class="button primary" href="/lab/">走进游乐场 <span>↗</span></a><a class="text-link" href="/research/">看看研究与学习 →</a></div><div class="hero-foot"><span>NANJING, CHINA</span><span>持续生长的个人实验室</span></div></div><OrbitCanvas/></section>
<div class="marquee"><span>RESEARCH</span><i>✳</i><span>BUILD</span><i>✳</i><span>PLAY</span><i>✳</i><span>DOCUMENT</span><i>✳</i><span>REPEAT</span></div>
<section class="section"><div class="section-heading"><div><p class="eyebrow">01 / PLAYGROUND</p><h2>不妨，动手试试。</h2></div><a class="text-link" href="/lab/">所有实验 <span>↗</span></a></div><div class="experiment-grid">{experiments.map(e=><a class="experiment-card" href={`/lab/${e.slug}/`}><Visual type={e.visual}/><div class="card-body"><div class="card-meta"><span>{e.en}</span><span>{e.number}</span></div><h3>{e.title}<span>↗</span></h3><p>{e.description}</p><span class="pill">{e.kind}</span></div></a>)}</div></section>
<section class="section project-section"><div class="section-heading"><div><p class="eyebrow">02 / WORK IN THE OPEN</p><h2>从问题，到小小的作品。</h2></div><a class="text-link" href="/projects/">项目档案 ↗</a></div>{projects.slice(0,2).map((p,i)=><a class="project-row" href={`/projects/#${p.id}`}><span class="row-number">0{i+1}</span><div><h3>{p.title}</h3><p>{p.description}</p></div><span class="project-status">{p.status}</span><span class="row-arrow">↗</span></a>)}</section>
<section class="section notes-home"><div><p class="eyebrow">03 / FIELD NOTES</p><h2>留下探索的痕迹。</h2><p class="muted">让笔记成为连接问题、实验与下一步的线。</p><a class="text-link" href="/notes/">翻开笔记本 →</a></div><div>{notes.map(n=><a class="note-row" href={`/notes/${n.id}/`}><div class="card-meta"><time datetime={n.data.date.toISOString()}>{n.data.date.toISOString().slice(0,10).replaceAll('-','.')}</time><span>{n.data.kind}</span></div><h3>{n.data.title}<span>↗</span></h3></a>)}</div></section>
<aside class="closing"><span class="big-asterisk">✳</span><p>有些答案需要时间。<br/><span class="serif">有些想法，值得先做出来。</span></p><a href="/about/">关于这个地方 ↗</a></aside>
</Layout>
