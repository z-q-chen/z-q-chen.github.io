---
import ArtLayout from '../layouts/ArtLayout.astro';
import ChannelShelf from '../components/ChannelShelf.astro';
import EchoPortrait from '../components/EchoPortrait.astro';
---
<ArtLayout>
<h1 class="sr-only">ECHO 的手绘小站</h1><span class="art-signature" lang="en">echo.</span>
<a class="art-profile" href="/about/" data-profile-open aria-label="查看 ECHO 的简介"><EchoPortrait/></a>
<div class="art-board"><ChannelShelf includeBook iconOnly/><svg class="art-ground" viewBox="0 0 900 24" aria-hidden="true"><path d="M5 12Q170 7 310 13T591 11T895 13M64 20Q240 17 396 21M656 18L814 20"/></svg></div>
<button class="art-motion" data-art-motion type="button" aria-label="暂停动效" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><g data-pause><path d="M8 5L7 19M17 5L16 19"/></g><path data-play d="M8 5L8 19L19 12Z"/></svg></button>
<dialog class="profile-card" aria-labelledby="profile-title" data-profile-card><div class="profile-paper"><button type="button" class="profile-close" data-profile-close aria-label="关闭简介"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6L18 18M17 6L6 18"/></svg></button><EchoPortrait/><h2 id="profile-title" lang="en">hello, I'm echo.</h2><p>写字，做东西，偶尔走神。</p><p>这里会慢慢装下我的创作。</p><div class="profile-links"><a href="/about/" aria-label="查看完整简介"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5Q8 3 12 6Q16 3 21 5L20 20Q16 18 12 21Q8 18 4 20ZM12 6V20"/></svg></a><a href="https://github.com/z-q-chen" aria-label="ECHO 的 GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3L3 8L8 13M16 11L21 16L16 21M14 4L10 20"/></svg></a></div></div></dialog>
</ArtLayout>
<script>
import {legacyEntries} from '../data/channels';
const old=legacyEntries.find(entry=>entry.id===location.hash.slice(1));if(old)location.replace(old.href);
const card=document.querySelector<HTMLDialogElement>('[data-profile-card]')!;
const opener=document.querySelector<HTMLAnchorElement>('[data-profile-open]')!;
opener.addEventListener('click',event=>{if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;event.preventDefault();card.showModal();});
document.querySelector('[data-profile-close]')!.addEventListener('click',()=>card.close());
card.addEventListener('click',event=>{if(event.target===card){const r=card.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)card.close();}});
card.addEventListener('close',()=>opener.focus({preventScroll:true}));
const toggle=document.querySelector<HTMLButtonElement>('[data-art-motion]')!;
const preference=matchMedia('(prefers-reduced-motion:reduce)');let paused=preference.matches;
function sync(){document.body.dataset.motion=paused?'paused':'running';toggle.setAttribute('aria-pressed',String(paused));toggle.setAttribute('aria-label',paused?'开启动效':'暂停动效');}
toggle.addEventListener('click',()=>{paused=!paused;sync();});preference.addEventListener('change',e=>{paused=e.matches;sync();});sync();
</script>
