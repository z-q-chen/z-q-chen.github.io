---
import Layout from '../layouts/Layout.astro';
import LittleSpark from '../components/LittleSpark.astro';
import ArticleRow from '../components/ArticleRow.astro';
import SeriesCard from '../components/SeriesCard.astro';
import ProductCard from '../components/ProductCard.astro';
import {published} from '../lib/content';
import {legacyEntries} from '../data/channels';
const {articles,series,products}=await published();const lead=articles.find(a=>a.data.featured)||articles[0];
---
<Layout><section class="home-hero"><div><p class="eyebrow"><span class="live-dot"></span> LEARNING IN PUBLIC</p><h1>学到的，<br/><span class="highlight">做出来。</span></h1><p class="hero-lede">我是 ECHO。把学习写成文章，<br class="mobile-only"/>把想法做成可以使用的东西。</p><div class="hero-actions"><a class="button ink" href="/articles/">读点新东西 <span>↗</span></a><a class="quiet-link" href="/about/">认识一下 →</a></div></div><div class="hero-note"><LittleSpark kind="star"/><p class="handwritten">one little thing<br/>at a time.</p><div class="mini-stats"><span><b>{articles.length}</b> 文章</span><span><b>{series.length}</b> 系列</span><span><b>{products.length}</b> 产品</span></div></div></section>
<div class="home-layout"><div class="home-main">{lead&&<section class="home-section"><div class="section-heading"><h2>最新产出 <span class="tiny-dot peach"></span></h2><a href="/articles/">全部文章 ↗</a></div><a class="featured-post purple" href={`/articles/${lead.id}/`}><div class="card-top"><span class="kind">{lead.data.kind}</span><span class="status">{lead.data.series?series.find(s=>s.id===lead.data.series)?.data.label:'ECHO JOURNAL'}</span></div><h2>{lead.data.title}</h2><p>{lead.data.description}</p><div class="card-bottom"><span>{lead.data.date.toISOString().slice(0,10)} · ECHO</span><span>开始阅读 ↗</span></div><span class="corner-doodle" aria-hidden="true">✷</span></a></section>}
{series.length>0&&<section class="home-section"><div class="section-heading"><h2>沿着一条线学 <span class="tiny-dot mint"></span></h2><a href="/series/">所有系列 ↗</a></div><div class="series-grid">{series.slice(0,2).map(group=><SeriesCard group={group} articles={articles}/>)}</div></section>}
<section class="home-section"><div class="section-heading"><h2>更多文字 <span class="tiny-dot yellow"></span></h2><a href="/articles/">归档 ↗</a></div>{articles.filter(a=>a.id!==lead?.id).slice(0,3).map(article=><ArticleRow article={article}/>)}{articles.length<2&&<p class="subtle-note">新的学习笔记，写好后再见。</p>}</section>
<section class="home-section"><div class="section-heading"><h2>产品 <span class="tiny-dot purple"></span></h2><a href="/products/">全部产品 ↗</a></div>{products.length?<div class="product-grid">{products.slice(0,2).map(product=><ProductCard product={product}/>)}</div>:<div class="product-invitation"><span aria-hidden="true">↗</span><div><h3>想法有了形状，就放在这里。</h3><p>每个产品一个独立网站，完成后从这里出发。</p></div></div>}</section></div>
<aside class="home-aside"><div class="hello-card mint"><div class="hello-top"><span class="avatar">e.</span><LittleSpark/></div><h2>你好，我是 ECHO。</h2><p>学习、写字、做东西。<br/>让每次尝试都留下点什么。</p><a class="quiet-link" href="/about/">关于我 →</a></div><a class="aside-note yellow" href="/links/"><span aria-hidden="true">↗</span><h3>书签与小店</h3><p>收藏的好入口，也有我的小店。</p></a><a class="aside-rss" href="/feed.xml"><span aria-hidden="true">◔</span><div>订阅更新<small>用 RSS，按自己的节奏读。</small></div><span>↗</span></a></aside></div></Layout>
<script define:vars={{entries:legacyEntries}}>const entry=entries.find(e=>e.id===location.hash.slice(1));if(entry)location.replace(entry.href);</script>
