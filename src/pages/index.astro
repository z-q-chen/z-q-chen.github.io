---
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import ArticleRow from '../components/ArticleRow.astro';
import {getCollection} from 'astro:content';
const works=(await getCollection('works',({data})=>!data.draft)).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
const articles=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,4);
---
<Layout>
<section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> CHEN ZHENGQUAN / PERSONAL DIGITAL LAB</p><h1>你好，我是<br/><span class="serif accent">陈正佺。</span><span class="asterisk">✳</span></h1><p class="hero-description">欢迎来到我的个人数字实验室。<br/>这里分享自己的作品，记录思考与教程，<br class="desktop-break"/>也给未来的新想法留一个位置。</p><div class="hero-actions"><a class="button primary" href="/about/">认识我 <span>↗</span></a><a class="text-link" href="/articles/">看看文章 →</a></div><div class="hero-foot"><span>NANJING, CHINA</span><span>作品 · 文字 · 日常探索</span></div></div>
<div class="studio-figure" aria-hidden="true"><div class="figure-caption"><span>z·q / DIGITAL LABORATORY</span><span>ROOM TO GROW</span></div><svg viewBox="0 0 480 320" fill="none"><path d="M40 160H440M240 30V290" stroke="#dfe5d1" stroke-opacity=".12"/><ellipse cx="240" cy="160" rx="150" ry="66" transform="rotate(-35 240 160)" stroke="#b8c5a4"/><ellipse cx="240" cy="160" rx="150" ry="66" transform="rotate(35 240 160)" stroke="#b8c5a4"/><ellipse cx="240" cy="160" rx="150" ry="66" transform="rotate(90 240 160)" stroke="#b8c5a4"/><circle cx="240" cy="160" r="7" fill="#eba07b"/><circle cx="117" cy="212" r="5" fill="#eba07b"/><circle cx="314" cy="48" r="4" fill="#dfe5d1"/><circle cx="336" cy="247" r="4" fill="#dfe5d1"/><text x="51" y="233">WORKS</text><text x="312" y="29">WORDS</text><text x="347" y="270">ME</text></svg><p>让作品与文字，慢慢连接。</p></div>
</section>
<div class="marquee"><span>MAKE</span><i>✳</i><span>THINK</span><i>✳</i><span>WRITE</span><i>✳</i><span>EXPLORE</span><i>✳</i><span>GROW</span></div>
<section class="section"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORKS</p><h2>把想法，做成作品。</h2></div><a class="text-link" href="/works/">全部作品 ↗</a></div>{works.length ? <div class="work-grid">{works.map(work=><WorkCard work={work}/>)}</div> : <div class="content-empty"><span class="empty-symbol" aria-hidden="true">↗</span><div><h3>暂无公开作品</h3><p>这里将展示我完成的工具、项目、游戏与其他创作。</p></div><a class="text-link" href="/works/">作品空间 →</a></div>}</section>
<section class="section articles-home"><div><p class="eyebrow">02 / RECENT WRITING</p><h2>最近在想、在写。</h2><p class="muted">思考、教程，以及创作过程中的记录。</p><a class="text-link" href="/articles/">全部文章 →</a></div><div>{articles.length ? articles.map(article=><ArticleRow article={article}/>) : <div class="content-empty article-empty"><span class="empty-symbol" aria-hidden="true">✎</span><div><h3>暂无已发布文章</h3><p>新的思考与教程会陆续出现在这里。</p></div></div>}</div></section>
<aside class="closing"><span class="big-asterisk">✳</span><p>保持好奇，<br/><span class="serif">给新的想法一点时间。</span></p><a href="/about/">关于我与这个地方 ↗</a></aside>
</Layout>
