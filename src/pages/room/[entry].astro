---
import {legacyEntries} from '../../data/channels';
export function getStaticPaths(){return legacyEntries.map(entry=>({params:{entry:entry.id},props:{destination:entry.href}}));}
const {destination}=Astro.props;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="ECHO 的手绘内容入口已更新。"/><meta name="robots" content="noindex,follow"/><meta http-equiv="refresh" content={`0;url=${destination}`}/><link rel="canonical" href={new URL(destination,Astro.site)}/><title>入口已更新 · ECHO</title></head><body><p>入口已更新，<a href={destination}>继续看看 →</a></p></body></html>
