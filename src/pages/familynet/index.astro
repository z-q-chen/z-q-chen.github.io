---
import release from '../../data/familynet-release.json';
const home='https://z-q-chen.github.io/familynet/';
const asset=(part:string)=>{const found=release.assets.find(a=>a.name.includes(part));if(!found)throw new Error('Missing release artifact');return found;};
const android=asset('android-arm64');
const downloads=[
 {label:'Ubuntu',detail:'26.04 · x64 · .deb',state:'本机运行已验证',file:asset('ubuntu-amd64'),action:'下载安装包'},
 {label:'Windows',detail:'x64 · 便携 ZIP',state:'未签名 · 待实机验证',file:asset('windows-x64'),action:'下载便携包'},
 {label:'Linux',detail:'x64 · 便携 tar.gz',state:'其他发行版待验证',file:asset('linux-x64'),action:'下载便携包'},
 {label:'完整源码',detail:'含修改、构建脚本与第三方许可',state:'GPL-3.0 / MIT',file:asset('source.zip'),action:'下载源码'},
];
const size=(bytes:number)=>`${(bytes/1_000_000).toFixed(1)} MB`;
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>FamilyNet — 下载与安装</title>
<meta name="description" content="下载 FamilyNet：Android arm64 测试 APK、Ubuntu 安装包、Windows 和 Linux 便携版。管理机场订阅、自有 VPS 节点与分流配置。"/>
<link rel="canonical" href={home}/><link rel="icon" href="/familynet/icon-0.3.5.png"/>
<meta property="og:title" content="FamilyNet — 下载与安装"/><meta property="og:description" content="Android、Ubuntu、Windows 与 Linux 下载。"/><meta property="og:type" content="website"/><meta property="og:url" content={home}/><meta property="og:image" content={home+'desktop-0.3.5.png'}/><meta name="theme-color" content="#f5f5f7"/>
</head>
<body>
<a class="skip" href="#main">跳到正文</a>
<header class="header"><nav class="wrap" aria-label="页面导航"><a class="brand" href={home}><img src="/familynet/icon-0.3.5.png" width="28" height="28" alt=""/>FamilyNet</a><div><a href="/products/">ECHO 的产品</a><a href={release.repository+'/releases/tag/'+release.releaseTag}>发布记录 ↗</a></div></nav></header>
<main id="main" class="wrap">
<section class="intro">
<div class="app-title"><img src="/familynet/icon-0.3.5.png" alt="" width="76" height="76"/><div><p class="version">Android {release.version} · Linux / Windows {release.desktopVersion}</p><h1>FamilyNet</h1></div></div>
<p class="description">管理机场订阅与自有 VPS 节点。</p>
<div class="primary-download"><a class="primary" href={android.url} data-download="android">下载 Android 版 <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12m-5-5 5 5 5-5M5 20h14"/></svg></a><p>arm64 · {size(android.bytes)} · 开发签名</p></div>
<p class="android-state">最低 Android 7（API 24）。支持覆盖升级；手机 VPN 与后台保活尚待实测。</p>
<p class="android-state"><a href="/familynet/quickstart-0.3.5.png" target="_blank" rel="noopener">安装与使用说明图 ↗</a></p>
</section>
<section class="downloads" id="download" aria-labelledby="downloads-title">
<div class="section-heading"><h2 id="downloads-title">其他下载</h2><a href="/familynet/SHA256SUMS">SHA256 校验清单 ↗</a></div>
<div class="download-list">{downloads.map(item=><article class="download-row"><div class="download-name"><h3>{item.label}</h3><p>{item.detail}</p></div><div class="download-meta"><span>{item.state}</span><small>{size(item.file.bytes)}</small></div><a href={item.file.url} class="download-link" data-download={item.label}>{item.action}<span aria-hidden="true"> ↗</span></a></article>)}</div>
<p class="availability">macOS、iOS / iPadOS 暂无自有安装包。</p>
</section>
<section class="preview" aria-label="桌面界面预览"><figure><img src="/familynet/desktop-0.3.5.png" width="1667" height="1217" alt="FamilyNet Linux 工具页，展示 ChatGPT、Gemini 等 13 项手动服务检测，当前尚未检测" loading="lazy"/><figcaption>Linux 0.3.5 · 服务状态</figcaption></figure></section>
<section class="guide" aria-labelledby="guide-title"><h2 id="guide-title">安装后</h2><ol><li><strong>导入配置。</strong>添加机场订阅地址，或导入自己的节点配置。</li><li><strong>选择节点。</strong>在客户端选择需要使用的线路。</li><li><strong>按需启用代理。</strong>系统代理或 VPN 的权限由你确认。</li></ol><p>Android：下载 APK 后在手机中打开，按系统提示允许本次来源安装。当前为开发签名测试版。</p></section>
<section class="notes" aria-labelledby="notes-title"><h2 id="notes-title">版本说明</h2><details><summary>现在支持什么？</summary><p>Clash/Mihomo 订阅、Base64 和标准节点链接的本地导入，节点组与分流、连接日志、本地加密备份。客户端不附带机场账号或节点。自有 VPS/CDN 的部署工具包含在源码中，目前主要通过命令行操作。</p></details><details><summary>哪些已经验证？</summary><p>三端统一为 0.3.5，共用图标、服务检测规则和测速口径。Linux 578 项回归、19 项实际程序回环验收通过；Android 4,446 项回归与安装包检查通过。Windows 已构建并校验 EXE 图标、版本及压缩包，尚未实机运行。真实机场、VPS/CDN、手机 VPN、后台保活及主机系统代理/TUN 接管仍待验收。</p></details><details><summary>联网与隐私</summary><p>订阅、节点、DNS 和规则资源按你的配置联网。服务状态由你手动点击检测；辅助自动更新、IP 查询和云备份关闭。公开安装包与源码不包含用户订阅、运行数据或签名私钥。</p></details><details><summary>源码与许可</summary><p>桌面基于 Clash Party 与 Mihomo，Android 基于 FlClash，保留 GPL-3.0、版权和第三方许可。独立控制平面使用 MIT。完整对应源码是本页的 source.zip 附件，包含修改和构建脚本；GitHub 自动生成的 Source code ZIP 只包含发行索引。</p></details></section>
</main>
<footer class="wrap"><a href="/">ECHO</a><span>FamilyNet {release.version}</span><a href={release.repository}>GitHub ↗</a></footer>
</body>
</html>
<style is:global>
:root{color-scheme:light;--bg:#f5f5f7;--surface:#fff;--text:#1d1d1f;--muted:#6e6e73;--line:#dedee2;--blue:#0066cc;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Noto Sans CJK SC','Microsoft YaHei',sans-serif;font-synthesis:none}*{box-sizing:border-box}html{scroll-padding-top:80px}body{margin:0;background:var(--bg);color:var(--text);font-size:15px;line-height:1.65;-webkit-font-smoothing:antialiased}a{color:var(--blue);text-decoration:none}a:hover{text-decoration:underline}a:focus-visible,summary:focus-visible{outline:3px solid #0071e3;outline-offset:5px;border-radius:4px}.wrap{width:min(100% - 64px,980px);margin:auto}img{display:block;max-width:100%;height:auto}h1,h2,h3,p,figure{margin:0}.skip{position:absolute;left:16px;top:-70px;background:white;padding:10px;z-index:5}.skip:focus{top:10px}.header{background:#ffffffbf;border-bottom:1px solid var(--line)}nav{height:64px;display:flex;align-items:center;justify-content:space-between}.brand{display:flex;gap:10px;align-items:center;color:var(--text);font-weight:650;font-size:18px}.brand img{border-radius:7px}nav>div{display:flex;gap:25px;font-size:12px}nav>div a{color:var(--muted)}.intro{padding:68px 0 48px}.app-title{display:flex;align-items:center;gap:22px}.app-title>img{border-radius:18px}.version{font-size:12px;color:var(--muted);margin-bottom:4px;letter-spacing:.04em}h1{font-size:46px;font-weight:650;line-height:1.15;letter-spacing:-.045em}.description{font-size:21px;margin-top:25px;letter-spacing:-.02em}.primary-download{display:flex;align-items:center;gap:22px;margin-top:31px}.primary{display:inline-flex;align-items:center;gap:15px;padding:12px 20px;background:#0071e3;color:white;border-radius:11px;font-weight:550;font-size:15px;transition:background .15s}.primary:hover{background:#0077ed;text-decoration:none}.primary svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.primary-download>p,.android-state{font-size:12px;color:var(--muted)}.android-state{margin-top:15px}.section-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:17px}h2{font-size:22px;font-weight:600;letter-spacing:-.025em}.section-heading>a{font-size:12px}.download-list{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:0 24px}.download-row{display:grid;grid-template-columns:1fr 220px 130px;align-items:center;gap:18px;padding:23px 0}.download-row+.download-row{border-top:1px solid var(--line)}h3{font-size:16px;font-weight:550}.download-name p,.download-meta{font-size:12px;color:var(--muted)}.download-name p{margin-top:4px}.download-meta small{display:block;font-size:11px;margin-top:3px}.download-link{text-align:right;font-size:13px;white-space:nowrap}.availability{font-size:12px;color:var(--muted);margin-top:14px}.preview{margin-top:48px}.preview figure{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:white}.preview img{width:100%}.preview figcaption{border-top:1px solid var(--line);font-size:11px;color:var(--muted);padding:12px 18px}.guide{display:grid;grid-template-columns:180px 1fr;gap:18px;margin-top:58px;padding:0 0 38px;border-bottom:1px solid var(--line)}.guide ol{padding:0 0 0 20px;margin:0}.guide li{padding-bottom:12px;font-size:14px;color:var(--muted)}.guide strong{color:var(--text);font-weight:550}.guide>p{grid-column:2;font-size:12px;color:var(--muted)}.notes{margin-top:35px}.notes h2{margin-bottom:15px}.notes details{padding:17px 0;border-bottom:1px solid var(--line)}.notes summary{font-size:14px;cursor:pointer;list-style-position:inside}.notes details p{font-size:13px;color:var(--muted);max-width:760px;margin-top:12px;line-height:1.9}footer{display:flex;align-items:center;gap:24px;padding:38px 0 32px;font-size:11px;color:var(--muted)}footer>a:first-child{color:var(--text);font-weight:600}footer>a:last-child{margin-left:auto}@media(max-width:650px){.wrap{width:calc(100% - 36px)}nav{height:58px}nav>div{gap:15px;font-size:11px}.brand{font-size:16px}.intro{padding-top:42px;padding-bottom:36px}.app-title{gap:15px}.app-title>img{width:62px;height:62px;border-radius:14px}h1{font-size:38px}.description{font-size:18px;margin-top:22px}.primary-download{display:block;margin-top:25px}.primary-download>p{margin-top:12px}.android-state{font-size:11px;max-width:340px}.section-heading{align-items:baseline}.section-heading>a{font-size:10px}h2{font-size:20px}.download-list{padding:0 17px}.download-row{grid-template-columns:1fr auto;gap:9px 12px;padding:19px 0}.download-name{grid-column:1}.download-link{grid-column:2;grid-row:1 / span 2;font-size:12px}.download-meta{font-size:10px;grid-column:1;grid-row:2}.download-meta small{display:inline;margin-left:8px;font-size:10px}.download-name p{font-size:11px}.preview{margin-top:30px}.preview figure{border-radius:10px}.guide{grid-template-columns:1fr;margin-top:35px;gap:20px;padding-bottom:27px}.guide>p{grid-column:1}.guide li{font-size:13px}.notes{margin-top:28px}footer{gap:15px;padding-top:28px}}@media(max-width:360px){nav>div a:first-child{display:none}h1{font-size:34px}.section-heading{display:block}.section-heading>a{display:inline-block;margin-top:8px}.download-meta small{display:block;margin-left:0}}@media(prefers-color-scheme:dark){:root{color-scheme:dark;--bg:#151517;--surface:#202023;--text:#f5f5f7;--muted:#a2a2aa;--line:#38383d;--blue:#64a7ff}.header{background:#202023bf}.skip{background:var(--surface)}.preview figure{background:var(--surface)}}@media(prefers-reduced-motion:reduce){.primary{transition:none}}
</style>
