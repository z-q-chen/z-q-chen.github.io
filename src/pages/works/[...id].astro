---
import Layout from '../../layouts/Layout.astro';
import {getCollection,render} from 'astro:content';
import {dateLabel} from '../../lib/editorial';
export async function getStaticPaths(){return(await getCollection('works',({data})=>!data.draft)).map(work=>({params:{id:work.id},props:{work}}));}
const {work}=Astro.props;const {Content}=await render(work);
---
<Layout title={`${work.data.title} · ECHO`} description={work.data.description} active="works"><article class="article-top"><a class="back-link" href="/works/">← 所有作品</a><header class="article-header"><div class="post-meta"><span class="post-kind">{work.data.kind}</span><time datetime={work.data.date.toISOString()}>{dateLabel(work.data.date)}</time></div><h1>{work.data.title}</h1><p class="article-description">{work.data.description}</p><div class="tags">{work.data.tags.map((tag:string)=><span># {tag}</span>)}</div></header><div class="reading-shell"><div>{work.data.cover&&<img class="detail-cover" src={work.data.cover} alt={work.data.title}/>}<div class="work-actions">{work.data.experience&&<a class="button" href={work.data.experience}>打开作品 ↗</a>}{work.data.source&&<a class="text-link" href={work.data.source}>查看源码 ↗</a>}</div><div class="prose"><Content/></div><footer class="article-footer"><a class="text-link" href="/works/">所有作品 <span>↗</span></a></footer></div></div></article></Layout>
