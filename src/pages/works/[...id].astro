---
import Layout from '../../layouts/Layout.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return(await getCollection('works',({data})=>!data.draft)).map(work=>({params:{id:work.id},props:{work}}));}
const {work}=Astro.props;const {Content}=await render(work);
---
<Layout title={`${work.data.title} · ECHO`} description={work.data.description} active="works"><article class="article"><a class="back-link" href="/works/">← 返回作品</a><header class="page-intro"><p class="eyebrow">{work.data.kind} / {work.data.date.toISOString().slice(0,10)}</p><h1>{work.data.title}</h1><p>{work.data.description}</p></header>{work.data.cover&&<img class="detail-cover" src={work.data.cover} alt={work.data.title}/>}<div class="work-actions">{work.data.experience&&<a class="button primary" href={work.data.experience}>打开作品 ↗</a>}{work.data.source&&<a class="text-link" href={work.data.source}>查看源码 ↗</a>}</div><div class="prose"><Content/></div><footer class="article-footer"><a href="/works/" class="text-link">更多作品 →</a></footer></article></Layout>
