---
const home='https://z-q-chen.github.io/cloudtogether/';
const repo='https://github.com/z-q-chen/CloudTogether';
const release=repo+'/releases/tag/v0.1.0';
const download=repo+'/releases/download/v0.1.0/cloudtogether_0.1.0_amd64.deb';
const portable=repo+'/releases/download/v0.1.0/CloudTogether-0.1.0-linux-x64-compact.tar.gz';
---
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>CloudTogether — 云伴，Linux 音乐客户端</title>
<meta name="description" content="你的歌单、桌面歌词，还有一起听。CloudTogether 是一款连接网易云音乐的 Linux 桌面客户端。下载 Ubuntu .deb 安装包。"/>
<link rel="canonical" href={home}/><link rel="icon" type="image/svg+xml" href="/cloudtogether/icon.svg"/>
<meta property="og:title" content="CloudTogether — 云伴"/><meta property="og:description" content="你的歌单、桌面歌词，还有一起听。为 Linux 桌面做的音乐客户端。"/><meta property="og:type" content="website"/><meta property="og:url" content={home}/><meta property="og:image" content={home+'social.png'}/>
<meta name="twitter:card" content="summary_large_image"/><meta name="theme-color" content="#09090b"/>
</head>
<body>
<a class="skip" href="#main">跳到正文</a>
<header class="header"><div class="nav wrap"><a class="brand" href={home}><img src="/cloudtogether/icon.svg" width="28" height="28" alt=""/><span>CloudTogether</span></a><nav aria-label="官网导航"><a href="#experience">体验</a><a href={repo}>GitHub</a></nav><a class="nav-install" href={download}>下载 <span>.deb</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12m-5-5 5 5 5-5M5 19h14"/></svg></a></div></header>
<main id="main">
<section class="hero wrap">
<p class="eyebrow">云伴 · FOR LINUX</p>
<h1>CloudTogether<span>.</span></h1>
<div class="hero-bottom"><div><p class="hero-lead">你的歌单、桌面歌词，<br class="mobile-break"/>还有一起听。</p><p class="hero-description">为 Linux 桌面做的网易云音乐客户端。</p></div><div class="hero-action"><a class="button" href={download}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12m-5-5 5 5 5-5M5 19h14"/></svg>下载 Ubuntu 版 <span>.deb</span></a><p>Ubuntu · x86_64 · 开源</p></div></div>
</section>
<section class="showcase wide" id="experience" aria-label="应用界面预览">
<div class="gallery-toolbar"><div role="tablist" aria-label="选择应用界面"><button id="tab-discover" role="tab" aria-selected="true" aria-controls="preview-discover" tabindex="0" data-preview="discover">发现音乐</button><button id="tab-player" role="tab" aria-selected="false" aria-controls="preview-player" tabindex="-1" data-preview="player">完整播放页</button><button id="tab-lyrics" role="tab" aria-selected="false" aria-controls="preview-lyrics" tabindex="-1" data-preview="lyrics">桌面歌词</button></div><span class="gallery-label">CLOUDTOGETHER / DESKTOP</span></div>
<div class="screen"><div id="preview-discover" class="preview" role="tabpanel" aria-labelledby="tab-discover"><img src="/cloudtogether/discover.webp" width="1360" height="795" alt="CloudTogether 发现页，推荐歌单和常驻播放栏" fetchpriority="high"/></div><div id="preview-player" class="preview" role="tabpanel" aria-labelledby="tab-player" hidden><img src="/cloudtogether/player.png" width="1360" height="795" alt="完整播放页，展示封面、歌词与播放控制，真实歌曲与同步歌词" loading="lazy"/></div><div id="preview-lyrics" class="preview lyrics-preview" role="tabpanel" aria-labelledby="tab-lyrics" hidden><img src="/cloudtogether/lyrics.png" width="1520" height="384" alt="独立桌面歌词窗口" loading="lazy"/></div></div>
<p class="gallery-caption" aria-live="polite" id="preview-caption">推荐、歌单、排行榜。打开就能找歌。</p>
</section>
<section class="essentials wrap"><p class="section-kicker">日常听歌</p><div class="essentials-top"><h2>从你的音乐开始。</h2><p>登录网易云账号，接着听自己的歌单。<br/>需要找新歌的时候，推荐和排行榜也在这里。</p></div><div class="essentials-list"><div><span>01</span><h3>发现</h3><p>推荐 · 歌单 · 新碟 · 听书与播客</p></div><div><span>02</span><h3>我的</h3><p>账号歌单 · 收藏歌单 · 喜欢的音乐</p></div><div><span>03</span><h3>播放</h3><p>自动联播 · 单曲循环 · 随机 · 心动推荐</p></div></div></section>
<section class="together wrap"><div class="feature-heading"><div><p class="section-kicker">一起听 <span class="beta">试用</span></p><h2>下一首，一起选。</h2></div><p>用共同队列听同一首歌。<br/>双人头像与云端累计时长，留住一起听过的时间。</p></div><figure class="together-screen"><img src="/cloudtogether/together.png" width="1360" height="795" alt="云伴真实一起听界面，双人头像与账号累计时长；昵称和头像已做隐私替换" loading="lazy"/><figcaption>实机截图 · 昵称与头像已替换</figcaption></figure></section>
<section class="lyrics wrap"><div><p class="section-kicker">桌面歌词</p><h2>收起窗口，<br/>歌词还在。</h2><p class="feature-description">写代码、读文档的时候，留一句歌词在桌面。<br/>位置、大小和字号，都可以随手调整。</p></div><div class="lyrics-stage"><img src="/cloudtogether/lyrics.png" width="1520" height="384" alt="CloudTogether 桌面歌词小窗" loading="lazy"/><span>独立置顶 · 拖动 · 缩放</span></div></section>
<section class="personal wrap"><div><p class="section-kicker">外观</p><h2>换个颜色，也很简单。</h2></div><div class="palette" aria-label="六款皮肤"><span style="--swatch:#252932" title="夜航">夜航</span><span style="--swatch:#e3e5ec" title="唱片纸">唱片纸</span><span style="--swatch:#486957" title="苔原">苔原</span><span style="--swatch:#bc889b" title="玫瑰灰">玫瑰灰</span><span style="--swatch:#9fc3de" title="海盐">海盐</span><span style="--swatch:#b98a4d" title="琥珀">琥珀</span></div></section>
<section class="download wrap" id="download"><div><p class="section-kicker">CLOUDTOGETHER</p><h2>装好，<br/>开始听。</h2><a class="button" href={download}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v12m-5-5 5 5 5-5M5 19h14"/></svg>下载 Ubuntu 版 <span>.deb</span></a><p class="download-meta">x86_64 · <span id="deb-size">约 106 MB</span></p></div><div class="download-details"><details><summary>安装后怎么打开？<span>+</span></summary><p>安装 .deb 文件后，在应用菜单中找到「云伴」。也可以在下载目录运行：</p><code>sudo apt install ./cloudtogether_0.1.0_amd64.deb</code></details><details><summary>想直接运行，不安装？<span>+</span></summary><p>下载便携版，解压后运行「启动云伴.sh」。</p><a href={portable}>下载便携版 ↗</a></details><details><summary>一起听和账号支持情况<span>+</span></summary><p>一起听为试用功能，手机端兼容性仍待确认。会员音源和账号写入的支持仍在完善。</p></details><div class="download-links"><a href={release}>发行说明 ↗</a><a href={repo+'/issues'}>反馈问题 ↗</a></div></div></section>
</main>
<footer class="footer wrap"><a class="brand" href={home}><img src="/cloudtogether/icon.svg" width="24" height="24" alt=""/><span>CloudTogether</span></a><p>由 <a href="/">ECHO</a> 制作</p><div><a href="https://github.com/NeteaseCloudMusicApiEnhanced/api-enhanced">API 致谢</a><a href={repo}>GitHub ↗</a></div></footer>
<script>
const buttons=[...document.querySelectorAll('[data-preview]')];
const captions={discover:'推荐、歌单、排行榜。打开就能找歌。',player:'封面、歌词与播放控制，实机截图。',lyrics:'主窗口最小化后，歌词小窗继续更新。'};
function select(button){const key=button.dataset.preview;for(const b of buttons){const active=b===button;b.setAttribute('aria-selected',String(active));b.tabIndex=active?0:-1;const panel=document.getElementById('preview-'+b.dataset.preview);if(panel)panel.hidden=!active;}const caption=document.getElementById('preview-caption');if(caption)caption.textContent=captions[key];}
for(const button of buttons){button.addEventListener('click',()=>select(button));button.addEventListener('keydown',event=>{const i=buttons.indexOf(button);let next=i;if(event.key==='ArrowRight')next=(i+1)%buttons.length;else if(event.key==='ArrowLeft')next=(i+buttons.length-1)%buttons.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=buttons.length-1;else return;event.preventDefault();select(buttons[next]);buttons[next].focus();});}
</script>
</body>
</html>
