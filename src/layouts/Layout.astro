---
import '../styles/global.css';
const {title='ECHO · Digital Lab', description='ECHO 的作品与文字。', active='',immersive=false}=Astro.props;
const nav=[['/works/','作品','works'],['/articles/','文章','articles'],['/about/','关于','about']];
---
<!doctype html>
<html lang="zh-CN">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#060910"/><title>{title}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={new URL(Astro.url.pathname,Astro.site)}/><link rel="alternate" type="application/rss+xml" title="ECHO · 文章" href="/feed.xml"/></head>
<body class:list={{immersive}}><a class="skip" href="#main">跳到内容</a>
<header class="site-header wrap"><a class="brand" href="/" aria-label="ECHO 首页"><svg viewBox="0 0 28 28" aria-hidden="true"><path d="M4 4H24M4 14H19M4 24H24"/></svg><span>ECHO</span></a><nav aria-label="主导航">{nav.map(([url,label,key])=><a href={url} aria-current={active===key?'page':undefined}>{label}</a>)}</nav></header>
<main id="main" class:list={[immersive?'main-immersive':'wrap']}><slot/></main>
<footer class="wrap footer"><span>© {new Date().getFullYear()} ECHO</span><div><a href="/feed.xml">RSS ↗</a><a href="https://github.com/z-q-chen">GitHub ↗</a><a href="/about/">关于 ↗</a></div></footer>
</body></html>
