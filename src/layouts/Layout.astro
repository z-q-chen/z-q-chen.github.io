---
import '../styles/site.css';
import InlineSearch from '../components/InlineSearch.astro';
const {title='ECHO',description='ECHO 的个人博客。学习笔记、课程系列，以及做出来的产品。',active='',noindex=false,article=false}=Astro.props;
const nav=[['/articles/','文章','articles'],['/series/','系列','series'],['/products/','产品','products'],['/links/','书签','links'],['/about/','关于','about']];
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#faf9f6"/><title>{title}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:url" content={new URL(Astro.url.pathname,Astro.site)}/><link rel="alternate" type="application/rss+xml" title="ECHO · 文章" href="/feed.xml"/>{noindex&&<meta name="robots" content="noindex,follow"/>}</head><body><a class="skip" href="#main">跳到内容</a><header class="site-header"><div class="header-inner wrap"><a class="brand" href="/" aria-label="ECHO 首页"><span class="brand-flower" aria-hidden="true">✳</span><span>echo<span class="brand-dot">.</span></span></a><div class="header-right"><button class="menu-toggle" aria-label="展开导航" aria-expanded="false" aria-controls="main-nav" hidden><span></span><span></span></button><nav id="main-nav" aria-label="主导航">{nav.map(([url,label,key])=><a href={url} aria-current={active===key?'page':undefined}>{label}</a>)}</nav><InlineSearch/></div></div></header><main class="wrap" id="main"><slot/></main><footer class="site-footer wrap"><div><a href="/" class="footer-brand">echo.</a><span>© {new Date().getFullYear()} ECHO</span><span class="owner-badge" hidden>作者模式</span></div><nav aria-label="页脚导航"><button class="motion-toggle" aria-pressed="false" hidden>动效 <span>开</span></button><a href="/feed.xml">RSS ↗</a><a href="https://github.com/z-q-chen">GitHub ↗</a><a href="/preferences/">偏好</a></nav></footer>
<script>
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle')!;menu.hidden=false;menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'收起导航':'展开导航');document.querySelector('.header-right')?.classList.toggle('nav-open',open);});
const toggle=document.querySelector<HTMLButtonElement>('.motion-toggle')!;const preference=matchMedia('(prefers-reduced-motion:reduce)');let saved:string|null=null;try{saved=localStorage.getItem('echo-motion');}catch{}let paused=saved?saved==='paused':preference.matches;
function sync(){document.body.dataset.motion=paused?'paused':'running';toggle.setAttribute('aria-pressed',String(paused));toggle.querySelector('span')!.textContent=paused?'关':'开';toggle.setAttribute('aria-label',paused?'开启动效':'暂停动效');}toggle.hidden=false;toggle.addEventListener('click',()=>{paused=!paused;try{localStorage.setItem('echo-motion',paused?'paused':'running');}catch{}sync();});preference.addEventListener('change',e=>{try{saved=localStorage.getItem('echo-motion');}catch{}if(!saved){paused=e.matches;sync();}});sync();
try{const owner=document.querySelector<HTMLElement>('.owner-badge');if(owner)owner.hidden=localStorage.getItem('echo-author-mode')!=='on';}catch{}

</script></body></html>
