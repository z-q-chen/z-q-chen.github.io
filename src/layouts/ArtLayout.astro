---
import '../styles/global.css';
import '../styles/shelves.css';
import '../styles/art-home.css';
const title='ECHO · 手绘小站',description='ECHO 的文章、音乐、游戏、图像、影像与小工具。';
---
<!doctype html><html lang="zh-CN"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f8f5ed"/>
<title>{title}</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="canonical" href={Astro.site}/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={Astro.site}/><link rel="alternate" type="application/rss+xml" title="ECHO · 文章" href="/feed.xml"/>
</head><body class="art-home"><main id="main" class="art-page"><slot/></main></body></html>
