---
const {type='orbits'}=Astro.props;
---
<div class:list={['visual',`visual-${type}`]} aria-hidden="true">
{['orbits','compress'].includes(type)&&<div class="orbit-art"><i></i><i></i><i></i><i></i><b></b></div>}
{type==='life'&&<div class="life-art">{Array.from({length:64},(_,i)=><i class:list={{lit:[10,18,19,26,28,35,36,37,43,44,45,51,52,53].includes(i)}}></i>)}</div>}
{type==='memory'&&<div class="memory-art"><i></i><i></i><i></i><i></i></div>}
{type==='rclone'&&<div class="link-art"><span>~/</span><i>⟷</i><span>☁</span></div>}
{type==='learning'&&<div class="type-art">a → b<span>tokens / systems / scale</span></div>}
{type==='agents'&&<div class="agent-art"><span>◎</span><i></i><span>◇</span><i></i><span>↗</span></div>}
</div>
