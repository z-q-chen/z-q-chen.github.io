---
import {portalGeometry} from '../lib/room-projection.mjs';
const {kind,prefix='scene'}=Astro.props;
const geometry=portalGeometry[kind as keyof typeof portalGeometry];
const points=geometry.outer.map(p=>p.join(',')).join(' ');
const clip=`${prefix}-${kind}-paint`;
---
<svg class="object-svg" viewBox="0 0 1536 1024" aria-hidden="true" data-object={kind}>
  <defs><clipPath id={clip}>{kind==='video'?<path d="M1196 440Q1195 413 1220 406L1447 389Q1471 390 1470 415L1468 587Q1468 607 1445 610L1223 612Q1200 612 1199 588Z"/>:<polygon points={points}/>}</clipPath>
  {kind==='video'&&<><clipPath id={`${clip}-volume`}><polygon points="1464,392 1507,411 1515,580 1491,610 1465,610"/><polygon points="1206,605 1496,605 1496,624 1206,624"/></clipPath><clipPath id={`${clip}-screen`}><path d="M1217 453Q1215 439 1232 434L1383 422Q1401 422 1400 440L1401 565Q1400 584 1383 582L1236 580Q1220 580 1220 563Z"/></clipPath></>}
  </defs>
  {kind==='video'&&<g class="tv-volume"><image href="/room/objects.webp" width="1536" height="1024" clip-path={`url(#${clip}-volume)`}/><path d="M1347 219L1388 379M1436 263L1396 379" fill="none" stroke="#655546" stroke-width="4" stroke-linecap="round"/><circle cx="1347" cy="219" r="5" fill="#867961"/><circle cx="1436" cy="263" r="5" fill="#867961"/><ellipse cx="1390" cy="383" rx="25" ry="14" fill="#48483b" stroke="#756953" stroke-width="3"/></g>}
  <g clip-path={`url(#${clip})`}>
    {kind==='games'?<image href="/room/echo.webp" x="129.024" y="117.76" width="1228.8" height="819.2"/>:<image href="/room/objects.webp" width="1536" height="1024"/>}
    {kind==='video'&&<g clip-path={`url(#${clip}-screen)`}><foreignObject x="1214" y="418" width="191" height="167"><div class="object-screen"><div class="tv-sky"><span class="tv-moon"></span><i class="tv-cloud cloud-a"></i><i class="tv-cloud cloud-b"></i><span class="tv-hill hill-a"></span><span class="tv-hill hill-b"></span></div><span class="tv-scan"></span><span class="tv-dot"></span></div></foreignObject></g>}
  </g>
</svg>
