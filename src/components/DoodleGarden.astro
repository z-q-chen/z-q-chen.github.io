<span class="flower-spark one" aria-hidden="true">✧</span><span class="flower-spark two" aria-hidden="true">✦</span><span class="flower-spark three" aria-hidden="true">✧</span>
</button>
</div>
<script>
document.querySelectorAll<HTMLElement>('[data-lively-garden]').forEach(garden=>{
  const plane=garden.querySelector<HTMLButtonElement>('.plane-button')!;
  plane.addEventListener('click',()=>{garden.classList.remove('plane-away');void garden.offsetWidth;garden.classList.add('plane-away');});
  garden.addEventListener('animationend',e=>{if(e.animationName==='plane-excursion')garden.classList.remove('plane-away');});
  garden.addEventListener('pointermove',e=>{
    if(e.pointerType!=='mouse'||document.body.dataset.motion==='paused')return;
    const rect=garden.getBoundingClientRect();
    const x=Math.max(-1,Math.min(1,((e.clientX-rect.left)/rect.width-.5)*2));
    const y=Math.max(-1,Math.min(1,((e.clientY-rect.top)/rect.height-.5)*2));
    garden.style.setProperty('--look-x',`${x*2.8}px`);garden.style.setProperty('--look-y',`${y*1.8}px`);
    garden.style.setProperty('--drift-x',`${x*4}px`);garden.style.setProperty('--drift-y',`${y*3}px`);
    garden.dataset.pointer='following';
  });
  const reset=()=>{['--look-x','--look-y','--drift-x','--drift-y'].forEach(p=>garden.style.removeProperty(p));garden.dataset.pointer='resting';};
  garden.addEventListener('pointerleave',reset);
  new MutationObserver(()=>{if(document.body.dataset.motion==='paused')reset();}).observe(document.body,{attributes:true,attributeFilter:['data-motion']});
});
document.querySelectorAll<HTMLButtonElement>('.flower-button').forEach(button=>{
  button.addEventListener('click',()=>{button.classList.remove('bloom');void button.offsetWidth;button.classList.add('bloom');});
  button.addEventListener('animationend',e=>{if(e.animationName==='flower-spin')button.classList.remove('bloom');});
});
</script>
