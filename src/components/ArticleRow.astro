---
const {article}=Astro.props;
---
<a class="article-row" href={`/articles/${article.id}/`}>
<div class="card-meta"><time datetime={article.data.date.toISOString()}>{article.data.date.toISOString().slice(0,10)}</time><span>{article.data.kind}</span></div>
<h3>{article.data.title}<span>↗</span></h3><p>{article.data.description}</p><div class="tags">{article.data.tags.map((t:string)=><span class="article-tag">#{t}</span>)}</div>
</a>
