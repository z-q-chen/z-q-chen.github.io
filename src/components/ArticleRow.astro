---
import {dateLabel,readingTime} from '../lib/editorial';
import CrayonFrame from './CrayonFrame.astro';
const {article,heading='h3'}=Astro.props;
const Heading=heading;
---
<a class="article-note" href={`/articles/${article.id}/`}><CrayonFrame id={`post-${article.id}`}/><div class="post-meta"><time datetime={article.data.date.toISOString()}>{dateLabel(article.data.date)}</time><span class="kind">{article.data.kind}</span><span>{readingTime(article.body)} 分钟</span></div><Heading class="note-title"><span class="crayon-underline">{article.data.title}</span></Heading><div class="tags">{article.data.tags.slice(0,3).map((tag:string)=><span># {tag}</span>)}</div><span class="note-arrow" aria-hidden="true">↗</span></a>
