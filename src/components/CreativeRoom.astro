---
import type { CollectionEntry } from 'astro:content';
import RoomObject from './RoomObject.astro';
import {roomEntries,channelOf} from '../data/room';
interface Props { articles: CollectionEntry<'articles'>[]; works: CollectionEntry<'works'>[] }
const {articles,works}=Astro.props;
const icons:Record<string,string>={book:'✎',music:'♫',games:'◇',images:'▧',video:'▷',about:'☺',drawer:'✧'};
---
<div class="room-shell" data-room data-phase="room">
  <main id="main" tabindex="-1"><h1 class="visually-hidden">ECHO 的手绘创作房间</h1>
    <div class="room-viewport" data-viewport>
      <div class="room-world" data-world>
        <img class="studio-plate" src="/room/environment.webp" width="1536" height="1024" alt="置身 ECHO 的手绘工作室，桌上有书、魔方与唱片，墙上挂着画，旁边是一台电视。" fetchpriority="high" decoding="async"/>
        <div class="scene-object" data-source="images"><RoomObject kind="images"/></div>
        <div class="scene-object" data-source="video"><RoomObject kind="video"/></div>
        <div class="window-night" aria-hidden="true"><i></i><i></i><i></i><i></i><b>☾</b></div>
        <svg class="headphone-wire" viewBox="0 0 1536 1024" aria-hidden="true"><path d="M625 355Q594 424 691 508Q730 611 830 582" fill="none" stroke="#5b473d" stroke-width="2.4" stroke-linecap="round"/></svg>
        <div class="echo-character" aria-hidden="true"><img class="echo-body" src="/room/echo.webp" width="1536" height="1024" alt=""/><img class="echo-head" src="/room/echo.webp" width="1536" height="1024" alt=""/><img class="echo-feet" src="/room/echo.webp" width="1536" height="1024" alt=""/></div>
        <div class="nature-layer vine-window" aria-hidden="true"><img src="/room/nature.webp" width="1536" height="1024" alt=""/></div>
        <div class="nature-layer vine-shelf" aria-hidden="true"><img src="/room/nature.webp" width="1536" height="1024" alt=""/></div>
        <div class="nature-layer plant-leaves" aria-hidden="true"><img src="/room/nature.webp" width="1536" height="1024" alt=""/></div>
        <div class="nature-layer vine-right" aria-hidden="true"><img src="/room/nature.webp" width="1536" height="1024" alt=""/></div>
        <div class="room-cat" aria-hidden="true"><img class="cat-body" src="/room/nature.webp" width="1536" height="1024" alt=""/><img class="cat-tail" src="/room/nature.webp" width="1536" height="1024" alt=""/><span class="cat-sleep">z<i>z</i></span></div>
        <button class="cat-touch" data-cat aria-label="摸摸猫" title="摸摸猫"></button>
        <div class="record-disc" aria-hidden="true"><span></span></div>
        <div class="floating-notes" aria-hidden="true"><i>♪</i><i>♫</i><i>♩</i></div>
        <div class="sun-dust" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <div class="lamp-glow" aria-hidden="true"></div>
        <svg class="notebook-ink" viewBox="0 0 130 35" aria-hidden="true"><path d="M8 12Q22 7 32 12T58 12M9 21Q21 16 43 20M71 10l10 4 9-7M74 23q12-9 24-1"/></svg>
        <button class="paper-plane" data-plane aria-label="让纸飞机飞一圈" title="放飞一下"><svg viewBox="0 0 120 72" aria-hidden="true"><path d="M7 22L112 5 76 63 58 40 7 22Z" fill="#f5f3e9"/><path d="M7 22L112 5 76 63 58 40 7 22ZM58 40L112 5 42 33M58 40L57 59 68 50" fill="none" stroke="#62584b" stroke-width="2" stroke-linejoin="round"/><path d="M58 40L112 5 42 33Z" fill="#9ebbc8" opacity=".5"/></svg></button>
        {roomEntries.map(entry=><a class={`room-hotspot hotspot-${entry.id}`} href={`/room/${entry.id}/`} data-entry={entry.id} data-target={entry.href} style={`--x:${entry.x}%;--y:${entry.y}%;--w:${entry.w}%;--h:${entry.h}%`} aria-label={entry.label}><span class="hotspot-halo"></span><span class="hotspot-label">{entry.label}<small>↗</small></span></a>)}
      </div>
    </div>
  </main>
  <div class="scene-tools" data-tools><span class="room-wordmark">ECHO</span><div><button data-light aria-label="切换到夜晚" aria-pressed="false" title="换个光线">☼</button><button data-map aria-label="打开房间入口地图" title="找东西">⌕</button><button data-motion aria-pressed="false" aria-label="暂停动效" title="动效"><span data-motion-label>Ⅱ</span></button></div></div>
  <p class="scene-hint">房间里的东西，可以点。</p>
  <button class="scene-step step-left" data-pan="left" aria-label="往房间左边看看">‹</button><button class="scene-step step-right" data-pan="right" aria-label="往房间右边看看">›</button>
  <dialog class="room-map" data-map-dialog aria-labelledby="map-title"><div class="map-paper"><button class="dialog-close" data-map-close aria-label="关闭入口地图">×</button><h2 id="map-title">想找点什么？</h2><div class="map-entries">{roomEntries.map(e=><a href={`/room/${e.id}/`} data-map-entry={e.id}><span aria-hidden="true">{icons[e.id]}</span>{e.label}<small>↗</small></a>)}</div><div class="map-foot"><a href="/feed.xml">RSS ↗</a><a href="https://github.com/z-q-chen" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div></dialog>
  <div class="portal-stage" data-portal-stage aria-hidden="true" hidden><div class="portal-shade"></div><div class="portal-plane" data-portal-plane></div></div>
  <div class="portal-library" aria-hidden="true" hidden>{roomEntries.map(e=><div data-portal-template={e.id}><RoomObject kind={e.id} prefix="portal"/></div>)}</div>
  <section class="channel-page" data-channel-page aria-label="房间里的内容" hidden><button class="channel-back" data-channel-close><span aria-hidden="true">↙</span> 回房间</button><div class="channel-page-inner">
  {roomEntries.map(entry=>{
    const selected=entry.channel==='all'?works:works.filter(w=>channelOf(w.data)===entry.channel);
    return <section class={`channel-view channel-${entry.id}`} data-channel={entry.id} hidden>
      <div class="channel-intro"><span class="channel-symbol" aria-hidden="true">{icons[entry.id]}</span><p class="channel-eyebrow">ECHO / {entry.id==='book'?'notebook':entry.id}</p><h2 tabindex="-1">{entry.name}</h2>{entry.hint&&<p>{entry.hint}</p>}</div>
      {entry.id==='about'?<div class="room-about"><img src="/room/echo.webp" alt="银白短发、猫耳、粉色外套的 ECHO" width="1536" height="1024"/><div><p>写字，做东西，偶尔走神。</p><p>这里会慢慢装下我的创作。</p><a href="https://github.com/z-q-chen" target="_blank" rel="noopener noreferrer">在 GitHub 找到我 ↗</a></div></div>:entry.id==='book'?articles.length?<div class="room-posts">{articles.map(a=><a href={`/articles/${a.id}/`}><time datetime={a.data.date.toISOString()}>{a.data.date.toISOString().slice(0,10)}</time><h3>{a.data.title}<span>↗</span></h3><p>{a.data.description}</p></a>)}</div>:<div class="channel-empty"><span class="empty-art" aria-hidden="true">✎<i>~</i></span><h3>{entry.empty}</h3><p>{entry.note}</p></div>:selected.length?<div class="room-products">{selected.map(w=><a href={w.data.experience||`/works/${w.id}/`}><div class="product-cover">{w.data.cover?<img src={w.data.cover} alt="" loading="lazy"/>:<span aria-hidden="true">{icons[entry.id]}</span>}</div><h3>{w.data.title}<span>↗</span></h3><p>{w.data.description}</p></a>)}</div>:<div class="channel-empty"><span class={`empty-art art-${entry.id}`} aria-hidden="true">{icons[entry.id]}<i>✧</i></span><h3>{entry.empty}</h3><p>{entry.note}</p></div>}
    </section>;
  })}
  </div></section>
  <noscript><div class="room-noscript"><p>动效需要 JavaScript，也可以直接打开：</p><a href="/articles/">本子</a><a href="/works/">抽屉</a><a href="/about/">ECHO</a></div></noscript>
</div>
<script>import '../scripts/room-controller';</script>
