---
import {sequence} from '../lib/content';
import CrayonFrame from './CrayonFrame.astro';
const {group,articles}=Astro.props;const entries=articles.filter(a=>a.data.series===group.id).sort(sequence);
---
<a class="series-card sketch-panel" href={`/series/${group.id}/`}><CrayonFrame id={`series-${group.id}`} tone="green"/><div class="card-top"><span class="course-label">{group.data.label}</span><span class="kind">{group.data.status}</span></div><h3>{group.data.title}</h3><div class="card-bottom"><span>{entries.length} 篇</span><span aria-hidden="true">↗</span></div></a>
