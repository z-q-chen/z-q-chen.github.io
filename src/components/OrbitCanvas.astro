---
const {large=false}=Astro.props;
---
<div class:list={['orbit-panel',{large}]}>
<div class="canvas-label"><span><i class="status-dot"></i> LIVE EXPERIMENT / 001</span><span>GENERATIVE GEOMETRY</span></div>
<canvas id="orbit-canvas" aria-label="几何轨道动画：围绕中心旋转的椭圆轨迹" role="img"></canvas>
<div class="orbit-controls"><span>秩序之中，留一点偶然。</span><button id="orbit-toggle" type="button">暂停动画 Ⅱ</button></div>
{large&&<div class="range-controls"><label>速度 <input id="orbit-speed" type="range" min="0.2" max="3" step="0.1" value="1"/></label><label>轨道 <input id="orbit-count" type="range" min="4" max="24" value="14"/></label><button id="orbit-reset">恢复初始</button></div>}
</div>
<script>
const canvas=document.querySelector<HTMLCanvasElement>('#orbit-canvas');
if(canvas){
 const ctx=canvas.getContext('2d')!; const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 let playing=!reduce,visible=!document.hidden,t=0,last=0,w=0,h=0,raf=0;
 const btn=document.querySelector<HTMLButtonElement>('#orbit-toggle')!;
 const speed=document.querySelector<HTMLInputElement>('#orbit-speed'); const count=document.querySelector<HTMLInputElement>('#orbit-count');
 function draw(){ctx.clearRect(0,0,w,h);ctx.fillStyle='#202722';ctx.fillRect(0,0,w,h);ctx.save();ctx.translate(w/2,h/2);const size=Math.min(w,h)*.34;let n=Number(count?.value||14);
  ctx.strokeStyle='rgba(210,219,199,.08)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(-w/2,0);ctx.lineTo(w/2,0);ctx.moveTo(0,-h/2);ctx.lineTo(0,h/2);ctx.stroke();
  for(let i=0;i<n;i++){ctx.save();ctx.rotate(i*Math.PI/n+t*.08);ctx.strokeStyle=i===0?'#e9a17f':`rgba(218,224,198,${.24+i/n*.3})`;ctx.lineWidth=i===0?1.8:.8;ctx.beginPath();ctx.ellipse(0,0,size,size*(.22+.12*Math.sin(t*.3+i*.12)),0,0,Math.PI*2);ctx.stroke();const a=t*.4+i*.49;ctx.fillStyle=i===0?'#ec9871':'#b7c3a2';ctx.beginPath();ctx.arc(Math.cos(a)*size,Math.sin(a)*size*(.22+.12*Math.sin(t*.3+i*.12)),i===0?4:1.7,0,Math.PI*2);ctx.fill();ctx.restore();}
 ctx.fillStyle='#f2e8d6';ctx.beginPath();ctx.arc(0,0,4,0,Math.PI*2);ctx.fill();ctx.restore();}
 function frame(now:number){if(playing&&visible){t+=Math.min((now-last)/1000,.05)*Number(speed?.value||1);draw();raf=requestAnimationFrame(frame);}last=now;}
 function sync(){btn.textContent=playing?'暂停动画 Ⅱ':'播放动画 ▷';cancelAnimationFrame(raf);last=performance.now();if(playing&&visible)raf=requestAnimationFrame(frame);else draw();}
 new ResizeObserver(()=>{const b=canvas.getBoundingClientRect();w=b.width;h=b.height;const d=Math.min(devicePixelRatio,2);canvas.width=w*d;canvas.height=h*d;ctx.setTransform(d,0,0,d,0,0);draw();}).observe(canvas);
 btn.addEventListener('click',()=>{playing=!playing;sync();});document.addEventListener('visibilitychange',()=>{visible=!document.hidden;sync();});
 speed?.addEventListener('input',draw);count?.addEventListener('input',draw);document.querySelector('#orbit-reset')?.addEventListener('click',()=>{t=0;if(speed)speed.value='1';if(count)count.value='14';draw();});sync();
}
</script>
